# Grant the logged-in user read/write access to Logitech HID++ devices so the
# Superstrike control panel can run without root.
#
# Install:
#   sudo cp packaging/99-logitech-superstrike.rules /etc/udev/rules.d/
#   sudo udevadm control --reload-rules && sudo udevadm trigger
# then replug the receiver (or reboot).

# All Logitech (046d) USB devices, including the LIGHTSPEED receiver.
KERNEL=="hidraw*", SUBSYSTEM=="hidraw", ATTRS{idVendor}=="046d", MODE="0660", TAG+="uaccess"
SUBSYSTEM=="usb", ATTRS{idVendor}=="046d", MODE="0660", TAG+="uaccess"
